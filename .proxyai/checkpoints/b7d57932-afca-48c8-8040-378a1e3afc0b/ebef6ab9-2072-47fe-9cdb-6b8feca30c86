nts.forEach((num, count) {\n76\t      if (count >= 9) {\n77\t        completed.add(num);\n78\t      }\n79\t    });\n80\t    return completed;\n81\t  }\n82\t\n83\t  @override\n84\t  void initState() {\n85\t    super.initState();\n86\t    _startNewGame();\n87\t  }\n88\t\n89\t  @override\n90\t  void dispose() {\n91\t    _timer?.cancel();\n92\t    super.dispose();\n93\t  }\n94\t\n95\t  void _saveHistory() {\n96\t    _undoHistory.add(_grid.copy());\n97\t    if (_undoHistory.length > 50) {\n98\t      _undoHistory.removeAt(0);\n99\t    }\n100\t  }\n101\t\n102\t  void _startNewGame() {\n103\t    _timer?.cancel();\n104\t    _startTime = DateTime.now();\n105\t    _elapsedSeconds = 0;\n106\t    _mistakeCount = 0;\n107\t    _showScoreOverlay = false;\n108\t    _undoHistory.clear();\n109\t    _isGlobalMemoMode = false;\n110\t    _timer = Timer.periodic(const Duration(seconds: 1), (timer) {\n111\t      setState(() {\n112\t        _elapsedSeconds++;\n113\t      });\n114\t    });\n115\t\n116\t    setState(() {\n117\t      _grid = SudokuGrid.fromIntGrid(\n118\t        _engine.generatePuzzle(difficulty: _difficultyRemovedCount),\n119\t      );\n120\t      _selectedRow = null;\n121\t      _selectedCol = null;\n122\t    });\n123\t  }\n124\t\n125\t  String _formatDuration(int totalSeconds) {\n126\t    final minutes = (totalSeconds ~/ 60).toString().padLeft(2, '0');\n127\t    final seconds = (totalSeconds % 60).toString().padLeft(2, '0');\n128\t    final hours = totalSeconds ~/ 3600;\n129\t    if (hours > 0) {\n130\t      final remainingMinutes = ((totalSeconds % 3600) ~/ 60).toString().padLeft(2, '0');\n131\t      return '$hours:$remainingMinutes:$seconds';\n132\t    }\n133\t    return '$minutes:$seconds';\n134\t  }\n135\t\n136\t  void _onCellTap(int row, int col) {\n137\t    setState(() {\n138\t      _selectedRow = row;\n139\t      _selectedCol = col;\n140\t\n141\t      if (_isGlobalMemoMode && _selectedRow != null && _selectedCol != null) {\n142\t        SudokuCell cell = _grid.cells[_selectedRow!][_selectedCol!];\n143\t        if (!cell.isFixed && cell.value == 0) {\n144\t          cell.isMemoMode = true;\n145\t        }\n146\t      }\n147\t    });\n148\t  }\n149\t\n150\t  void _autoRemoveMemoNumbers(int r, int c, int number) {\n151\t    for (int row = 0; row < 9; row++) {\n152\t      for (int col = 0; col < 9; col++) {\n153\t        if (row == r && col == c) continue;\n154\t\n155\t        bool isSameRow = (row == r);\n156\t        bool isSameCol = (col == c);\n157\t        bool isSameBox = (row ~/ 3 == r ~/ 3) && (col ~/ 3 == c ~/ 3);\n158\t\n159\t        if (isSameRow || isSameCol || isSameBox) {\n160\t          SudokuCell targetCell = _grid.cells[row][col];\n161\t          if (targetCell.memos.contains(number)) {\n162\t            targetCell.memos.remove(number);\n163\t            if (targetCell.memos.isEmpty) {\n164\t              targetCell.isMemoMode = false;\n165\t            }\n166\t          }\n167\t        }\n168\t      }\n169\t    }\n170\t  }\n171\t\n172\t  void _onNumberSelected(int number) {\n173\t    if (_selectedRow != null && _selectedCol != null) {\n174\t      SudokuCell targetCell = _grid.cells[_selectedRow!][_selectedCol!];\n175\t      if (targetCell.isFixed) return;\n176\t\n177\t      _saveHistory();\n178\t\n179\t      setState(() {\n180\t        if (_isGlobalMemoMode) {\n181\t          targetCell.isMemoMode = true;\n182\t          if (targetCell.memos.contains(number)) {\n183\t            targetCell.memos.remove(number);\n184\t            if (targetCell.memos.isEmpty) {\n185\t              targetCell.isMemoMode = false;\n186\t            }\n187\t          } else if (targetCell.memos.length < 9) {\n188\t            targetCell.memos.add(number);\n189\t          }\n190\t        } else {\n191\t          List<List<int>> tempGrid = _grid.toIntGrid();\n192\t          tempGrid[_selectedRow!][_selectedCol!] = 0;\n193\t          if (!_engine.isValid(tempGrid, _selectedRow!, _selectedCol!, number)) {\n194\t            _mistakeCount++;\n195\t          }\n196\t          _grid.set(_selectedRow!, _selectedCol!, number);\n197\t          _autoRemoveMemoNumbers(_selectedRow!, _selectedCol!, number);\n198\t          _validateGrid();\n199\t          _checkCompletion();\n200\t        }\n201\t      });\n202\t    }\n203\t  }\n204\t\n205\t  void _onToggleMemoMode() {\n206\t    setState(() {\n207\t      _isGlobalMemoMode = !_isGlobalMemoMode;\n208\t      if (_selectedRow != null && _selectedCol != null) {\n209\t        SudokuCell targetCell = _grid.cells[_selectedRow!][_selectedCol!];\n210\t        if (!targetCell.isFixed && targetCell.value == 0) {\n211\t          if (_isGlobalMemoMode) {\n212\t            targetCell.isMemoMode = true;\n213\t          } else if (targetCell.memos.isEmpty) {\n214\t            targetCell.isMemoMode = false;\n215\t          }\n216\t        }\n217\t      }\n218\t    });\n219\t  }\n220\t\n221\t  void _onClear() {\n222\t    if (_selectedRow != null && _selectedCol != null) {\n223\t      SudokuCell targetCell = _grid.cells[_selectedRow!][_selectedCol!];\n224\t      if (!targetCell.isFixed) {\n225\t        _saveHistory();\n226\t        setState(() {\n227\t          _grid.set(_selectedRow!, _selectedCol!, 0);\n228\t          targetCell.isMemoMode = false;\n229\t          targetCell.memos.clear();\n230\t          _validateGrid();\n231\t        });\n232\t      }\n233\t    }\n234\t  }\n235\t\n236\t  void _onUndo() {\n237\t    if (_undoHistory.isNotEmpty) {\n238\t      setState(() {\n239\t        _grid = _undoHistory.removeLast();\n240\t        _validateGrid();\n241\t      });\n242\t    }\n243\t  }\n244\t\n245\t  void _validateGrid() {\n246\t    _grid.resetInvalidStates();\n247\t    List<List<int>> currentIntGrid = _grid.toIntGrid();\n248\t    \n249\t    for (int r = 0; r < 9; r++) {\n250\t      for (int c = 0; c < 9; c++) {\n251\t        int val = currentIntGrid[r][c];\n252\t        if (val != 0) {\n253\t          currentIntGrid[r][c] = 0;\n254\t          if (!_engine.isValid(currentIntGrid, r, c, val)) {\n255\t            _grid.cells[r][c].isInvalid = true;\n256\t          }\n257\t          currentIntGrid[r][c] = val;\n258\t        }\n259\t      }\n260\t    }\n261\t  }\n262\t\n263\t  int _getBaseScore(String difficulty) {\n264\t    switch (difficulty) {\n265\t      case '초급':\n266\t        return 100;\n267\t      case '중급':\n268\t        return 300;\n269\t      case '고급':\n270\t        return 600;\n271\t      default:\n272\t        return 100;\n273\t    }\n274\t  }\n275\t\n276\t  int _getCurrentGameScore() {\n277\t    int score = _getBaseScore(_currentDifficulty) - _mistakeCount;\n278\t    return score < 0 ? 0 : score;\n279\t  }\n280\t\n281\t  int _calculateFinalScore(int totalSeconds) {\n282\t    int baseScore = _getBaseScore(_currentDifficulty);\n283\t    int targetSeconds;\n284\t\n285\t    switch (_currentDifficulty) {\n286\t      case '초급':\n287\t        targetSeconds = 180;\n288\t        break;\n289\t      case '중급':\n290\t        targetSeconds = 360;\n291\t        break;\n292\t      case '고급':\n293\t        targetSeconds = 600;\n294\t        break;\n295\t      default:\n296\t        targetSeconds = 180;\n297\t    }\n298\t\n299\t    int timeScore;\n300\t    if (totalSeconds <= targetSeconds) {\n301\t      timeScore = baseScore + (targetSeconds - totalSeconds);\n302\t    } else {\n303\t      int penalty = totalSeconds - targetSeconds;\n304\t      timeScore = baseScore - penalty;\n305\t    }\n306\t\n307\t    int score = (timeScore - _mistakeCount) * _difficultyMultiplier;\n308\t    return score < 0 ? 0 : score;\n309\t  }\n310\t\n311\t  void _checkCompletion() {\n312\t    if (_engine.isGridComplete(_grid.toIntGrid())) {\n313\t      _timer?.cancel();\n314\t      int finalScore = _calculateFinalScore(_elapsedSeconds);\n315\t\n316\t      showDialog(\n317\t        context: context,\n318\t        barrierDismissible: false,\n319\t        builder: (_) => Dialog(\n320\t          shape: RoundedRectangleBorder(\n321\t            borderRadius: BorderRadius.circular(24),\n322\t          ),\n323\t          elevation: 10,\n324\t          backgroundColor: const Color(0xFFFAF8EF),\n325\t          child: Container(\n326\t            padding: const EdgeInsets.all(24),\n327\t            decoration: BoxDecoration(\n328\t              color: const Color(0xFFFAF8EF),\n329\t              borderRadius: BorderRadius.circular(24),\n330\t              border: Border.all(color: const Color(0xFFBBADA0), width: 2),\n331\t            ),\n332\t            child: Column(\n333\t              mainAxisSize: MainAxisSize.min,\n334\t              children: [\n335\t                Container(\n336\t                  padding: const EdgeInsets.all(16),\n337\t                  decoration: const BoxDecoration(\n338\t                    color: Color(0xFFEEE4DA),\n339\t                    shape: BoxShape.circle,\n340\t                  ),\n341\t                  child: const Icon(\n342\t                    Icons.emoji_events_rounded,\n343\t                    size: 48,\n344\t                    color: Color(0xFFEDC22E),\n345\t                  ),\n346\t                ),\n347\t                const SizedBox(height: 16),\n348\t                const Text(\n349\t                  '축하합니다!',\n350\t                  style: TextStyle(\n351\t                    fontSize: 24,\n352\t                    fontWeight: FontWeight.w900,\n353\t                    color: Color(0xFF776E65),\n354\t                  ),\n355\t                ),\n356\t                const SizedBox(height: 6),\n357\t                const Text(\n358\t                  '스도쿠를 성공적으로 완성하셨습니다 🎉',\n359\t                  style: TextStyle(\n360\t                    fontSize: 13,\n361\t                    color: Color(0xFF776E65),\n362\t                  ),\n363\t                ),\n364\t                const SizedBox(height: 20),\n365\t                Container(\n366\t                  padding: const EdgeInsets.all(16),\n367\t                  decoration: BoxDecoration(\n368\t                    color: const Color(0xFFBBADA0),\n369\t                    borderRadius: BorderRadius.circular(16),\n370\t                  ),\n371\t                  child: Column(\n372\t                    children: [\n373\t                      _buildResultRow('난이도', '$_currentDifficulty', Colors.white),\n374\t                      const Divider(height: 16, thickness: 1, color: Color(0xFFEEE4DA)),\n375\t                      _buildResultRow('경과 시간', _formatDuration(_elapsedSeconds), const Color(0xFFEEE4DA)),\n376\t                      const Divider(height: 16, thickness: 1, color: Color(0xFFEEE4DA)),\n377\t                      _buildResultRow('최종 점수', '$finalScore점 ⭐', const Color(0xFFEDC22E), isBold: true),\n378\t                    ],\n379\t                  ),\n380\t                ),\n381\t                const SizedBox(height: 24),\n382\t                SizedBox(\n383\t                  width: double.infinity,\n384\t                  child: ElevatedButton.icon(\n385\t                    onPressed: () {\n386\t                      Navigator.pop(context);\n387\t                      _startNewGame();\n388\t                    },\n389\t                    icon: const Icon(Icons.play_arrow_rounded, color: Colors.white),\n390\t                    label: const Text(\n391\t                      '새 게임 시작하기',\n392\t                      style: TextStyle(\n393\t                        fontSize: 16,\n394\t                        fontWeight: FontWeight.bold,\n395\t                        color: Colors.white,\n396\t                      ),\n397\t                    ),\n398\t                    style: ElevatedButton.styleFrom(\n399\t                      backgroundColor: const Color(0xFF8F7A66),\n400\t                      padding: const EdgeInsets.symmetric(vertical: 14),\n401\t                      shape: RoundedRectangleBorder(\n402\t                        borderRadius: BorderRadius.circular(16),\n403\t                      ),\n404\t                      elevation: 4,\n405\t                    ),\n406\t                  ),\n407\t                ),\n408\t              ],\n409\t            ),\n410\t          ),\n411\t        ),\n412\t      );\n413\t    }\n414\t  }\n415\t\n416\t  Widget _buildResultRow(String label, String value, Color valueColor, {bool isBold = false}) {\n417\t    return Row(\n418\t      mainAxisAlignment: MainAxisAlignment.spaceBetween,\n419\t      children: [\n420\t        Text(\n421\t          label,\n422\t          style: TextStyle(\n423\t            fontSize: 14,\n424\t            fontWeight: isBold ? FontWeight.bold : FontWeight.normal,\n425\t            color: const Color(0xFFEEE4DA),\n426\t          ),\n427\t        ),\n428\t        Text(\n429\t          value,\n430\t          style: TextStyle(\n431\t            fontSize: isBold ? 16 : 14,\n432\t            fontWeight: isBold ? FontWeight.w900 : FontWeight.bold,\n433\t            color: valueColor,\n434\t          ),\n435\t        ),\n436\t      ],\n437\t    );\n438\t  }\n439\t\n440\t  PopupMenuItem<String> _buildMenuItem(String level, IconData icon, Color iconColor) {\n441\t    bool isSelected = _currentDifficulty == level;\n442\t    return PopupMenuItem<String>(\n443\t      value: level,\n444\t      child: Container(\n445\t        padding: const EdgeInsets.symmetric(vertical: 4, horizontal: 8),\n446\t        decoration: BoxDecoration(\n447\t          color: isSelected ? const Color(0xFFEDC22E) : Colors.transparent,\n448\t          borderRadius: BorderRadius.circular(8),\n449\t        ),\n450\t        child: Row(\n451\t          children: [\n452\t            Icon(\n453\t              icon,\n454\t              size: 18,\n455\t              color: isSelected ? Colors.white : iconColor,\n456\t            ),\n457\t            const SizedBox(width: 10),\n458\t            Expanded(\n459\t              child: Text(\n460\t                level,\n461\t                style: TextStyle(\n462\t                  fontSize: 13,\n463\t                  fontWeight: isSelected ? FontWeight.bold : FontWeight.normal,\n464\t                  color: isSelected ? Colors.white : const Color(0xFF776E65),\n465\t                ),\n466\t              ),\n467\t            ),\n468\t            if (isSelected)\n469\t              const Icon(Icons.check, size: 16, color: Colors.white),\n470\t          ],\n471\t        ),\n472\t      ),\n473\t    );\n474\t  }\n475\t\n476\t  bool _isRelated(int r, int c) {\n477\t    if (_selectedRow == null || _selectedCol == null) return false;\n478\t    if (r == _selectedRow && c == _selectedCol) return false;\n479\t\n480\t    if (r == _selectedRow || c == _selectedCol) return true;\n481\t\n482\t    int selectedVal = _grid.get(_selectedRow!, _selectedCol!);\n483\t    if (selectedVal != 0 && _grid.get(r, c) == selectedVal) return true;\n484\t\n485\t    return false;\n486\t  }\n487\t\n488\t  @override\n489\t  Widget build(BuildContext context) {\n490\t    return Scaffold(\n491\t      backgroundColor: const Color(0xFFFAF8EF),\n492\t      appBar: AppBar(\n493\t        backgroundColor: const Color(0xFFFAF8EF),\n494\t        centerTitle: false,\n495\t        titleSpacing: 12.0,\n496\t        title: Row(\n497\t          mainAxisSize: MainAxisSize.min,\n498\t          children: [\n499\t            Container(\n500\t              padding: const EdgeInsets.all(6),\n501\t              decoration: BoxDecoration(\n502\t                color: const Color(0xFFEEE4DA),\n503\t                borderRadius: BorderRadius.circular(10),\n504\t              ),\n505\t              child: const Icon(\n506\t                Icons.grid_3x3_rounded,\n507\t                color: Color(0xFF776E65),\n508\t                size: 20,\n509\t              ),\n510\t            ),\n511\t            const SizedBox(width: 8),\n512\t            const Text(\n513\t              'Chloe Sudoku',\n514\t              style: TextStyle(\n515\t                fontSize: 22,\n516\t                fontWeight: FontWeight.bold,\n517\t                color: Color(0xFF776E65),\n518\t              ),\n519\t            ),\n520\t          ],\n521\t        ),\n522\t        actions: [\n523\t          Padding(\n524\t            padding: const EdgeInsets.only(right: 12.0),\n525\t            child: OutlinedButton(\n526\t              onPressed: _startNewGame,\n527\t              style: OutlinedButton.styleFrom(\n528\t                foregroundColor: const Color(0xFF776E65),\n529\t                side: const BorderSide(color: Color(0xFFBBADA0), width: 1.5),\n530\t                shape: RoundedRectangleBorder(\n531\t                  borderRadius: BorderRadius.circular(12),\n532\t                ),\n533\t              ),\n534\t              child: const Text(\n535\t                '새 게임',\n536\t                style: TextStyle(fontWeight: FontWeight.bold),\n537\t              ),\n538\t            ),\n539\t          ),\n540\t        ],\n541\t      ),\n542\t      body: SafeArea(\n543\t        child: LayoutBuilder(\n544\t          builder: (context, constraints) {\n545\t            double maxBoardHeight = constraints.maxHeight - 200;\n546\t            if (maxBoardHeight < 200) maxBoardHeight = 200;\n547\t            double boardSize = (constraints.maxWidth - 16) < maxBoardHeight ? (constraints.maxWidth - 16) : maxBoardHeight;\n548\t\n549\t            return SingleChildScrollView(\n550\t              physics: const ClampingScrollPhysics(),\n551\t              child: Column(\n552\t                children: [\n553\t                  const SizedBox(height: 4),\n554\t                  Padding(\n555\t                    padding: const EdgeInsets.symmetric(horizontal: 10.0, vertical: 4.0),\n556\t                    child: Container(\n557\t                      padding: const EdgeInsets.symmetric(horizontal: 10.0, vertical: 8.0),\n558\t                      decoration: BoxDecoration(\n559\t                        color: const Color(0xFFBBADA0),\n560\t                        borderRadius: BorderRadius.circular(12),\n561\t                      ),\n562\t                      child: Row(\n563\t                        mainAxisAlignment: MainAxisAlignment.spaceBetween,\n564\t                        children: [\n565\t                          // 난이도 선택 버튼\n566\t                          PopupMenuButton<String>(\n567\t                            initialValue: _currentDifficulty,\n568\t                            onSelected: (String level) {\n569\t                              if (_currentDifficulty != level) {\n570\t                                setState(() {\n571\t                                  _currentDifficulty = level;\n572\t                                  _startNewGame();\n573\t                                });\n574\t                              }\n575\t                            },\n576\t                            color: const Color(0xFFFAF8EF),\n577\t                            elevation: 6,\n578\t                            shape: RoundedRectangleBorder(\n579\t                              borderRadius: BorderRadius.circular(16),\n580\t                            ),\n581\t                            itemBuilder: (context) => [\n582\t                              _buildMenuItem('초급', Icons.sentiment_satisfied_alt, const Color(0xFF8F7A66)),\n583\t                              _buildMenuItem('중급', Icons.sentiment_neutral, const Color(0xFF8F7A66)),\n584\t                              _buildMenuItem('고급', Icons.local_fire_department, const Color(0xFF8F7A66)),\n585\t                            ],\n586\t                            child: Container(\n587\t                              padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),\n588\t                              decoration: BoxDecoration(\n589\t                                color: const Color(0xFF776E65),\n590\t                                borderRadius: BorderRadius.circular(8),\n591\t                              ),\n592\t                              child: Row(\n593\t                                mainAxisSize: MainAxisSize.min,\n594\t          